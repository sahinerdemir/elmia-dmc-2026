    <style id="elmia-services-custom-css">
        /* Service Hero Banner Backgrounds */
        .page-template-default #pxl-page-title-elementor .elementor-element-8e40857 {
            background-size: cover !important;
            background-position: center center !important;
            position: relative !important;
        }
        .page-template-default #pxl-page-title-elementor .elementor-element-8e40857::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.75) 100%);
            z-index: 1;
        }
        .page-template-default #pxl-page-title-elementor .elementor-element-8e40857 .e-con-inner {
            position: relative;
            z-index: 2;
        }
        
        /* Service Specific Background Images */
        body[class*="miami-destination-management"] #pxl-page-title-elementor .elementor-element-8e40857 {
            background-image: url('https://images.unsplash.com/photo-1506953823976-52e1fdc0149a?auto=format&fit=crop&w=1920&q=80') !important;
        }
        body[class*="corporate-group-travel"] #pxl-page-title-elementor .elementor-element-8e40857 {
            background-image: url('https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=1920&q=80') !important;
        }
        body[class*="executive-chauffeur"] #pxl-page-title-elementor .elementor-element-8e40857 {
            background-image: url('https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=1920&q=80') !important;
        }
        body[class*="airport-fbo-transfers"] #pxl-page-title-elementor .elementor-element-8e40857 {
            background-image: url('https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?auto=format&fit=crop&w=1920&q=80') !important;
        }
        body[class*="trade-show-expo"] #pxl-page-title-elementor .elementor-element-8e40857 {
            background-image: url('https://images.unsplash.com/photo-1587825140708-dfaf72ae4b04?auto=format&fit=crop&w=1920&q=80') !important;
        }
        body[class*="government-delegation"] #pxl-page-title-elementor .elementor-element-8e40857 {
            background-image: url('https://images.unsplash.com/photo-1520106212299-d99c443e4568?auto=format&fit=crop&w=1920&q=80') !important;
        }
        
        /* Service Landing Page Spacing & Polish */
        .elmia-service-landing {
            margin-top: 25px;
            margin-bottom: 50px;
        }
        .elmia-service-landing .elmia-summary-box {
            background: #eaf4ec;
            border: 1px solid #b8dfbf;
            border-radius: 12px;
            padding: 30px 35px;
            margin-top: 15px;
            margin-bottom: 50px;
        }
        .elmia-service-landing .elmia-overview-section {
            margin-top: 40px;
            margin-bottom: 45px;
        }
        .elmia-service-landing .elmia-features-grid {
            margin-top: 35px;
            margin-bottom: 55px;
        }
        .elmia-service-landing .elmia-feature-card {
            background: #fff;
            border: 1px solid #eaeaea;
            border-radius: 12px;
            padding: 30px;
            height: 100%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            margin-bottom: 25px;
        }
        .elmia-service-landing .elmia-faq-section {
            margin-top: 55px !important;
            margin-bottom: 50px !important;
            clear: both;
        }
        .elmia-service-landing .elmia-faq-title {
            color: #285735;
            margin-bottom: 28px !important;
            font-size: 1.85rem;
            font-weight: 700;
        }
        .elmia-service-landing .elmia-faq-item {
            margin-bottom: 22px;
            padding: 24px 28px;
            background: #f9fbf9;
            border-left: 4px solid #285735;
            border-radius: 6px;
        }
        .elmia-service-landing .elmia-cta-banner {
            background: linear-gradient(135deg, #285735 0%, #173620 100%);
            border-radius: 16px;
            padding: 50px 35px;
            text-align: center;
            color: #fff;
            margin-top: 65px;
            margin-bottom: 40px;
            box-shadow: 0 10px 30px rgba(40,87,53,0.15);
        }

        /* Services Dropdown Menu - Luxury Green Styling & Right Arrow Indicator */
        .pxl-nav-menu .sub-menu {
            background-color: #ffffff !important;
            border-radius: 8px !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1) !important;
            border: 1px solid #eef2ee !important;
            padding: 10px 0 !important;
        }
        .pxl-nav-menu .sub-menu > li > a {
            color: #285735 !important;
            font-weight: 500 !important;
            font-size: 15px !important;
            padding: 10px 24px !important;
            transition: all 0.25s ease !important;
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
        }
        .pxl-nav-menu .sub-menu > li > a .pxl-menu-item-text {
            margin-left: 0 !important;
            color: #285735 !important;
            transition: all 0.25s ease !important;
        }
        .pxl-nav-menu .sub-menu > li > a .pxl-menu-item-text:before {
            display: none !important;
        }
        .pxl-nav-menu .sub-menu > li:hover > a,
        .pxl-nav-menu .sub-menu > li:hover > a .pxl-menu-item-text {
            color: #173620 !important;
            background-color: #f4f8f5 !important;
        }
        /* Active Page in Dropdown: No indent, elegant right arrow indicator */
        .pxl-nav-menu .sub-menu > li.current-menu-item > a,
        .pxl-nav-menu .sub-menu > li.current_page_item > a {
            background-color: #eaf4ec !important;
            color: #285735 !important;
            font-weight: 700 !important;
        }
        .pxl-nav-menu .sub-menu > li.current-menu-item > a .pxl-menu-item-text,
        .pxl-nav-menu .sub-menu > li.current_page_item > a .pxl-menu-item-text {
            margin-left: 0 !important;
            color: #285735 !important;
            font-weight: 700 !important;
        }
        .pxl-nav-menu .sub-menu > li.current-menu-item > a::after,
        .pxl-nav-menu .sub-menu > li.current_page_item > a::after {
            content: '→' !important;
            font-size: 16px !important;
            font-weight: 700 !important;
            color: #285735 !important;
            margin-left: 12px !important;
            display: inline-block !important;
        }
    </style>
